      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.Token) {",
              "    pm.environment.set(\"auth_token\", jsonData.Token);",
              "    pm.environment.set(\"teacher_id\", jsonData.objDeviceUserInfo.UserId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Username\": \"teacher\",\n  \"Password\": \"teacher123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/Device/ValidateUser",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "Device",
            "ValidateUser"
          ]
        }
      },
      "response": []
    },
    {
